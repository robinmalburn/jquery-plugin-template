{
  "name": "jquery-plugin-template",
  "version": "5.2.-",
  "description": "jQuery plugin template to speed up development of jQuery plugins by providing a solid, feature-rich plugin foundation.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "mocha",
    "check": "pnpm run lint && pnpm run test"
  },
  "keywords": [
    "jquery",
    "jquery-plugin",
    "template",
    "plugins",
    "jquery-template"
  ],
  "author": "Robin Malburn <robin.malburn@googlemail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/robinmalburn/jquery-plugin-template.git"
  },
  "bugs": {
    "url": "https://github.com/robinmalburn/jquery-plugin-template/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "jquery": "^4.0.0",
    "jsdom": "^30.1.3",
    "mocha": "^12.0.3"
  },
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.16.0"
  }
